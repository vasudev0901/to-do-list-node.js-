<!DOCTYPE html>
<html>

<head>
    <title>To Do List</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h1>To Do List</h1>

        <form action="/add" method="get">
            <input type="text" name="name" placeholder="Enter Name" required>
            <button>Add</button>

        </form>

        <ul>
            <% tasks.map((item)=> { %>
                <li>

                    <span>
                        <%= item.name %>
                    </span>

                    <a href="/delete/<%= item.id %>">
                        Remove
                    </a>
                </li>
                <% }) %>

        </ul>
    </div>
</body>

</html>